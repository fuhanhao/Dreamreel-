# 生产环境 — 复制为 /opt/dreamreel/.env.prod
POSTGRES_PASSWORD=change-me
IMAGE_TAG=latest

# 前端 API 基址（运行时注入，改后 docker compose restart web 即可，无需重建镜像）
# 留空 = 同源相对路径（Nginx 反代 /api/v1/ 时使用）
API_BASE_URL=

# 若前端与 API 不同域，可显式指定，例如：
# API_BASE_URL=https://api.example.com

JWT_SECRET=change-me-min-32-chars
TOKENFREE_API_KEY=
ARK_API_KEY=
